# =============================================================================
# Gemini Enterprise License Sync — Configuration
# Copy this file to .env and fill in your values:   cp .env.example .env
# =============================================================================

# Your GCP project ID (alphanumeric)
PROJECT_ID="your-project-id"

# Numeric project number (find via: ./gemini-helpers.sh get-project-number)
PROJECT_NUMBER="123456789012"

# API location — "global", "us", or "eu"
LOCATION="global"
ENDPOINT_LOCATION="global"

# Group → Subscription mapping
# Find subscription IDs via: ./gemini-helpers.sh list-configs
#
# Format: GROUP_EMAIL=SUBSCRIPTION_ID (one per line)
# The script reads these as GROUP_1, GROUP_2, GROUP_3, etc.
GROUP_1_EMAIL="gemini-ent-frontline@yourdomain.com"
GROUP_1_SUBSCRIPTION="SUBSCRIPTION_ID_FRONTLINE"

GROUP_2_EMAIL="gemini-ent-standard@yourdomain.com"
GROUP_2_SUBSCRIPTION="SUBSCRIPTION_ID_STANDARD"

GROUP_3_EMAIL="gemini-ent-plus@yourdomain.com"
GROUP_3_SUBSCRIPTION="SUBSCRIPTION_ID_PLUS"

# Set to "true" to revoke licenses from users not in the group
# WARNING: Keep "false" on first run to avoid accidentally removing existing users
DELETE_UNASSIGNED="false"

# Number of users per API call (default: 100)
BATCH_SIZE=100
